{
  "version": 1,
  "split": "validation",
  "description": "验证集：held-out 题材，检验测试集结论的外部效度。每个题材指定抽样的迁移方向与档位。",
  "templates": {
    "plant": "我们在做「{name}」项目。硬约定：1) 本地端口固定 {port}；2) 数据库用 {db}，明确禁止引入 {ban}；3) 核心逻辑写在 {path}；4) 提交信息必须用{lang}写。请逐条确认，并各补一句简短理由。（本轮只做文字确认，不要创建、修改或读取任何文件）",
    "probe": "请根据会话目标里的交接摘要回答（每问一句话，直接给答案，不要读任何文件）：1) 本地端口是多少？2) 数据库选型是什么、禁止引入什么？3) 核心逻辑文件路径？4) 提交信息用什么语言？",
    "drift": "按交接约定执行下一步：写出这个项目的本地启动命令（含端口）和核心逻辑文件的第一行代码或注释。不要创建或读取任何文件，直接用文字给出。",
    "bare": "我们在做「{name}」项目。这是上个会话未完成的任务，请继续推进。",
    "probeBare": "请回答关于这个项目的以下问题（每问一句话，直接给答案，不要读任何文件）：1) 本地端口是多少？2) 数据库选型是什么、禁止引入什么？3) 核心逻辑文件路径？4) 提交信息用什么语言？",
    "driftBare": "请执行下一步：写出这个项目的本地启动命令（含端口）和核心逻辑文件的第一行代码或注释。不要创建或读取任何文件，直接用文字给出。"
  },
  "themes": [
    {
      "name": "物联网采集",
      "db": "TimescaleDB",
      "ban": "InfluxDB",
      "path": "iot/collector.py",
      "port": 7606,
      "lang": "中文",
      "directions": [
        {
          "from": "standard",
          "to": "code",
          "tier": "flash"
        },
        {
          "from": "standard",
          "to": "cordis",
          "tier": "pro"
        }
      ],
      "facts": [
        {
          "key": "port",
          "expect": [
            "7606"
          ]
        },
        {
          "key": "db",
          "expect": [
            "TimescaleDB"
          ]
        },
        {
          "key": "ban",
          "expect": [
            "InfluxDB"
          ]
        },
        {
          "key": "path",
          "expect": [
            "iot/collector.py"
          ]
        },
        {
          "key": "lang",
          "expect": [
            "中文"
          ]
        }
      ]
    },
    {
      "name": "游戏存档服务",
      "db": "SQLite",
      "ban": "S3",
      "path": "saves/store.ts",
      "port": 7707,
      "lang": "English",
      "directions": [
        {
          "from": "cordis",
          "to": "minimal",
          "tier": "pro"
        },
        {
          "from": "standard",
          "to": "minimal",
          "tier": "flash"
        }
      ],
      "facts": [
        {
          "key": "port",
          "expect": [
            "7707"
          ]
        },
        {
          "key": "db",
          "expect": [
            "SQLite"
          ]
        },
        {
          "key": "ban",
          "expect": [
            "S3"
          ]
        },
        {
          "key": "path",
          "expect": [
            "saves/store.ts"
          ]
        },
        {
          "key": "lang",
          "expect": [
            "English"
          ]
        }
      ]
    },
    {
      "name": "日志分析平台",
      "db": "ClickHouse",
      "ban": "Hadoop",
      "path": "logs/query.py",
      "port": 7808,
      "lang": "中文",
      "directions": [
        {
          "from": "code",
          "to": "standard",
          "tier": "pro"
        },
        {
          "from": "standard",
          "to": "cordis",
          "tier": "flash"
        }
      ],
      "facts": [
        {
          "key": "port",
          "expect": [
            "7808"
          ]
        },
        {
          "key": "db",
          "expect": [
            "ClickHouse"
          ]
        },
        {
          "key": "ban",
          "expect": [
            "Hadoop"
          ]
        },
        {
          "key": "path",
          "expect": [
            "logs/query.py"
          ]
        },
        {
          "key": "lang",
          "expect": [
            "中文"
          ]
        }
      ]
    }
  ]
}